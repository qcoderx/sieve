# Build artifacts
/sieve
/sieve.exe
/dist/

# Local output
/artifacts/
/scratch-artifacts/
/traces/
*.sieve

# Go
*.test
*.out

# Distilled output from local runs. These are regenerable by definition -- each
# is whatever `sieve distill` produced on some machine on some day -- and they
# are large, numerous, and change on every run. /reports is the conventional
# place for them here; the question sets under testdata name it in their
# examples.
/reports/
/scratch-*/
/artifacts-*/
tout.txt

# Snapshot dumps written by @playwright/mcp during benchmarking.
/.playwright-mcp/

# Fetched by npm/install.js at install time, never committed.
/npm/bin/sieve
/npm/bin/sieve.exe
/npm/node_modules/

# Scratch space for recording the demo: a Linux sieve binary built for WSL,
# and whatever vhs leaves behind. Not part of the build.
.demo/
